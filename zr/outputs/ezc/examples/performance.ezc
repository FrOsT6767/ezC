// Tight integer loop: all work is native x86-64 instructions.
// Build with: python3 ezc.py examples/performance.ezc -o performance
// Check the exit code (it is 0 when the loop produced the expected result).

fn sum_to(limit: i64) -> i64 {
    var i = 0;
    var total = 0;
    while i < limit {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn main() -> i32 {
    let answer = sum_to(1000000);
    if answer == 499999500000 {
        println("one million native loop iterations completed");
        return 0;
    }
    return 1;
}
